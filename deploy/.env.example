# Copy to `.env` next to docker-compose.yml on the server and fill in.

# Image to run. Use the tag that scripts/build-image.sh printed, e.g.
#   ghcr.io/<github-user>/roster-tracker:26.10   (pushed to a registry)
#   roster-tracker:latest                        (copied with docker save/load)
ROSTER_IMAGE=ghcr.io/your-github-user/roster-tracker:latest

# Public address of the app. With no domain, use the server IP and port.
# 203.0.113.10 is an example address; replace it with your server's IP.
ROSTER_INSTANCE_URL=http://203.0.113.10:5230

# Port on the server (the container always listens on 5230).
ROSTER_HOST_PORT=5230

# Where the database and uploads are stored on the server.
ROSTER_DATA_DIR=./data

# Time zone for logs, e.g. Asia/Jakarta.
TZ=UTC
